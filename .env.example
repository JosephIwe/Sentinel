# ==============================================================================
# Sentinel API Intelligence Platform - Environment Variables
# ==============================================================================

# Server & Runtime Configuration (Optional)
# PORT: The port the Express server binds to (Defaults to 3000)
PORT="3000"
# NODE_ENV: Runtime environment (e.g. development, production)
NODE_ENV="production"

# AI Meta-Analysis Core API (Required)
# GEMINI_API_KEY: Secret key used to access Gemini models for report summaries and deep intelligence analysis.
# Set via your hosting environment or local .env file.
GEMINI_API_KEY="your-gemini-api-key-here"

# Connector Credential Config (Optional)
# GITHUB_TOKEN: GitHub Personal Access Token (PAT) to perform high-rate-limit scans via the GitHub REST API.
GITHUB_TOKEN=""

# Cache TTL Configurations in Milliseconds (Optional)
# WHOIS_CACHE_TTL_MS: TTL duration for domain registry WHOIS lookups. Defaults to 3600000 (1 hour).
WHOIS_CACHE_TTL_MS="3600000"

# DNS_CACHE_TTL_MS: TTL duration for active authoritative query loops. Defaults to 300000 (5 minutes).
DNS_CACHE_TTL_MS="300000"

# GITHUB_CACHE_TTL_MS: TTL duration for GitHub repository scanners. Defaults to 3600000 (1 hour).
GITHUB_CACHE_TTL_MS="3600000"

# INVESTIGATION_CACHE_TTL_MS: TTL duration for aggregated investigation scans. Defaults to 300000 (5 minutes).
INVESTIGATION_CACHE_TTL_MS="300000"

# SECURITYTXT_CACHE_TTL_MS: TTL duration for security.txt (RFC 9116) lookups. Defaults to 1800000 (30 minutes).
SECURITYTXT_CACHE_TTL_MS="1800000"

# TECHFINGERPRINT_CACHE_TTL_MS: TTL duration for technology fingerprint lookups. Defaults to 1800000 (30 minutes).
TECHFINGERPRINT_CACHE_TTL_MS="1800000"

# TECHFINGERPRINT_TIMEOUT_MS: Per-request timeout for the technology fingerprint
# homepage fetch. Defaults to 4000 (4 seconds), deliberately below the
# orchestrator's 5000ms per-connector default so this connector's own
# descriptive error is reported rather than a generic outer timeout.
TECHFINGERPRINT_TIMEOUT_MS="4000"

# CT_CACHE_TTL_MS: TTL duration for Certificate Transparency (crt.sh) lookups.
# Defaults to 3600000 (1 hour) - CT log contents change slowly.
CT_CACHE_TTL_MS="3600000"

# CT_TIMEOUT_MS: Per-request timeout for the Certificate Transparency lookup.
# Defaults to 4000 (4 seconds), below the orchestrator's 5000ms per-connector
# default so this connector's own descriptive error is reported. crt.sh is
# frequently slow, so timeouts are an expected outcome.
CT_TIMEOUT_MS="4000"

# ASN_CACHE_TTL_MS: TTL duration for ASN / IP intelligence lookups.
# Defaults to 3600000 (1 hour) - BGP allocations change slowly.
ASN_CACHE_TTL_MS="3600000"

# ASN_TIMEOUT_MS: Per-lookup timeout for the ASN / IP intelligence DNS
# queries. Defaults to 4000 (4 seconds), below the orchestrator's 5000ms
# per-connector default so this connector's own descriptive error is
# reported rather than a generic outer timeout.
ASN_TIMEOUT_MS="4000"

# RDAP_CACHE_TTL_MS: TTL duration for RDAP registry lookups, and for the
# cached IANA bootstrap registry. Defaults to 3600000 (1 hour) -
# registration records change slowly.
RDAP_CACHE_TTL_MS="3600000"

# RDAP_TIMEOUT_MS: Per-request timeout for RDAP bootstrap and registry
# queries. Defaults to 4000 (4 seconds), below the orchestrator's 5000ms
# per-connector default so this connector's own descriptive error is
# reported rather than a generic outer timeout.
RDAP_TIMEOUT_MS="4000"

# RDAP_BOOTSTRAP_URL: The IANA RDAP bootstrap registry for DNS (RFC 7484),
# used to discover each TLD's authoritative RDAP service. Override only to
# point at a mirror. Defaults to https://data.iana.org/rdap/dns.json
RDAP_BOOTSTRAP_URL="https://data.iana.org/rdap/dns.json"

# REVERSE_DNS_CACHE_TTL_MS: TTL duration for reverse DNS (PTR) lookups.
# Defaults to 300000 (5 minutes), matching the forward DNS connector -
# PTR records are ordinary DNS data and change on the same timescale.
REVERSE_DNS_CACHE_TTL_MS="300000"

# REVERSE_DNS_TIMEOUT_MS: Per-lookup timeout for reverse DNS queries and
# the forward-confirmation lookups. Defaults to 4000 (4 seconds), below the
# orchestrator's 5000ms per-connector default so this connector's own
# descriptive error is reported rather than a generic outer timeout.
REVERSE_DNS_TIMEOUT_MS="4000"

# HTTPHEADERS_CACHE_TTL_MS: TTL duration for HTTP security header
# inspections. Defaults to 1800000 (30 minutes), matching the technology
# fingerprint connector - both read the same live response surface.
HTTPHEADERS_CACHE_TTL_MS="1800000"

# HTTPHEADERS_TIMEOUT_MS: Per-request timeout for the HTTP security header
# inspection. Defaults to 4000 (4 seconds), below the orchestrator's 5000ms
# per-connector default so this connector's own descriptive error is
# reported rather than a generic outer timeout.
HTTPHEADERS_TIMEOUT_MS="4000"

# DNSSEC_CACHE_TTL_MS: TTL duration for DNSSEC lookups. Defaults to
# 3600000 (1 hour) - DNSSEC keys and delegations change infrequently.
DNSSEC_CACHE_TTL_MS="3600000"

# DNSSEC_TIMEOUT_MS: Per-query timeout for the DNSSEC DNS queries. Defaults
# to 4000 (4 seconds), below the orchestrator's 5000ms per-connector default
# so this connector's own descriptive error is reported rather than a
# generic outer timeout.
DNSSEC_TIMEOUT_MS="4000"

# DNSSEC_RESOLVER: IP address of the recursive resolver to query for DNSSEC
# records. Defaults to the system's first configured nameserver. The
# reported validation status comes from this resolver's Authenticated Data
# flag, so pin a known validating resolver if that matters. Ignored unless
# the value is a valid IP address.
DNSSEC_RESOLVER=""

# SHODAN_API_KEY: API key for the Shodan host API. The Shodan connector is
# inert without it: it returns NO_DATA with a "not configured" diagnostic and
# makes no request. An unconfigured connector never resembles a target with
# nothing to find.
SHODAN_API_KEY=""

# SHODAN_CACHE_TTL_MS: TTL duration for Shodan host lookups. Defaults to
# 3600000 (1 hour) - Shodan's own scan data updates far more slowly than
# that, and each lookup costs an API credit.
SHODAN_CACHE_TTL_MS="3600000"

# SHODAN_TIMEOUT_MS: Per-request timeout for Shodan API calls. Defaults to
# 4000 (4 seconds), below the orchestrator's 5000ms per-connector default so
# this connector's own descriptive error is reported rather than a generic
# outer timeout.
SHODAN_TIMEOUT_MS="4000"

# Private Beta Access Gate (Optional)
# APP_ACCESS_CODE: When set, gates the web UI behind a one-time shared access
# code (signed HttpOnly cookie, ~30 day lifetime). Does not apply to /api/*
# requests. Leave unset to disable the gate entirely. See utils/betaGate.ts.
APP_ACCESS_CODE=""
